<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <com.mraulio.gbcameramanager.utils.TouchImageView
            android:id="@+id/iv_rgb_batch_preview"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_rgb_batch_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/sw_rgb_batch_neutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_neutral_rgb" />

        <Switch
            android:id="@+id/sw_rgb_batch_crop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cb_crop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rgb_grouping_label" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_rgb_group_by_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rgb_grouping_by_image" />

            <RadioButton
                android:id="@+id/rb_rgb_group_by_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rgb_grouping_by_color" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/row_rgb_batch_aeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/average_rgb_aeb_label" />

            <Spinner
                android:id="@+id/spinner_rgb_batch_aeb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rgb_channel_order_label" />

        <LinearLayout
            android:id="@+id/row_rgb_batch_pos1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rgb_position_one" />

            <Spinner
                android:id="@+id/spinner_rgb_batch_pos1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_rgb_batch_pos2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rgb_position_two" />

            <Spinner
                android:id="@+id/spinner_rgb_batch_pos2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_rgb_batch_pos3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rgb_position_three" />

            <Spinner
                android:id="@+id/spinner_rgb_batch_pos3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_rgb_batch_pos4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rgb_position_four" />

            <Spinner
                android:id="@+id/spinner_rgb_batch_pos4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel_rgb_batch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="@string/cancel" />

            <Button
                android:id="@+id/btn_save_rgb_batch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>