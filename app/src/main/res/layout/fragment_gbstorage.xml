<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="5dp"
    android:paddingBottom="10dp"
    android:paddingHorizontal="10dp"
    tools:context=".ui.gbstorage.GbStorageFragment">

    <TextView
        android:id="@+id/tvGbStorageStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeTextType="uniform"
        android:maxLines="1"
        android:textAlignment="center"
        android:textSize="20sp" />

    <GridView
        android:id="@+id/gridViewGbStorage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:horizontalSpacing="10dp"
        android:numColumns="3"
        android:stretchMode="columnWidth"
        android:verticalSpacing="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="5">

        <Button
            android:id="@+id/btnGbStorageFirstPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:drawableRight="@drawable/ic_double_arrow"
            android:drawableTint="@color/white"
            android:rotation="180" />

        <Button
            android:id="@+id/btnGbStoragePrevPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:drawableRight="@drawable/ic_arrow"
            android:drawableTint="@color/white"
            android:rotation="180" />

        <TextView
            android:id="@+id/tvGbStoragePage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1 / 1" />

        <Button
            android:id="@+id/btnGbStorageNextPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:drawableRight="@drawable/ic_arrow"
            android:drawableTint="@color/white" />

        <Button
            android:id="@+id/btnGbStorageLastPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:drawableRight="@drawable/ic_double_arrow"
            android:drawableTint="@color/white" />
    </LinearLayout>
</LinearLayout>